<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_application"
    app:startDestination="@id/mainFragment">

    <include app:graph="@navigation/login_graph" />
    <include app:graph="@navigation/nav_graph_bottom" />
    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.smurzik.onboarding.presentation.OnboardingFragment"
        android:label="OnboardingFragment" />
    <fragment
        android:id="@+id/mainFragment"
        android:name="com.smurzik.main.MainFragment"
        android:label="MainFragment">
        <deepLink app:uri="app://bottom_navigation" />

    </fragment>
</navigation>